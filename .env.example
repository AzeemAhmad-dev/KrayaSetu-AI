# ==============================================================================
# KrayaSetu AI (SIH26027) - Global Deployment & Environment Configuration
# ==============================================================================

# --- Frontend Configuration (Vercel) ---
# Set this in Vercel to your deployed Render backend URL:
VITE_API_BASE_URL=https://your-backend-url.onrender.com

# --- Backend Configuration (Render) ---
HOST=0.0.0.0
PORT=8000
DATABASE_URL=sqlite:///./krayasetu.db

# --- Live Train Telemetry (RailRadar API) ---
# Documentation: https://railradar.in/docs
# Base URL: https://api.railradar.in/v1
RAILRADAR_API_BASE_URL=https://api.railradar.in/v1
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_TIMEOUT_SECONDS=0.5
