# ==============================================================================
# KrayaSetu AI - Backend Environment Configuration
# ==============================================================================

# Server Network Binding
HOST=0.0.0.0
PORT=8000

# SQLite / Database Connection
DATABASE_URL=sqlite:///./krayasetu.db

# Live Train Telemetry (RailRadar API)
# Official documentation: https://railradar.in/docs
# Default public endpoint: https://api.railradar.in/v1
RAILRADAR_API_BASE_URL=https://api.railradar.in/v1
RAILRADAR_API_KEY=your_railradar_api_key_here
RAILRADAR_TIMEOUT_SECONDS=0.5
